// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id        Int     @id @default(autoincrement())
  username  String
  email     String  @unique
  password  String
  role      Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profileImage String?
  favorites  Favorite[] 
  reviews Review[]
  journals Journal[]
  recipes Recipe[]
  transactions Transaction[]
  tutorialAccesses UserTutorialAccess[]
  activities Activity[]
   isPremium Boolean @default(false)
}

enum Role {
  ADMIN
  USER
}

enum RecipeStatus {
  PENDING
  APPROVED
  REJECTED
}

model Recipe {
  id Int @id @default(autoincrement())
  title       String
  description String @db.Text
  imageUrl String?
  category String
  prepTime String
  cookTime String
  servings Int
  calories Int
  ingredients String
  steps       String
  rating Float @default(0)
  status RecipeStatus @default(APPROVED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites Favorite[]
  reviews Review[]
  journals    JournalEntry[]
  authorId Int?
  categories RecipeCategory[]
  ingredientItems Ingredient[]
  stepItems Step[]
  tutorial Tutorial?
  tags RecipeTag[]
  isPremium Boolean @default(false)
  

author User? @relation(fields: [authorId], references: [id])
}

model Favorite {
  userId    Int
  recipeId  Int
  savedAt   DateTime @default(now())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@id([userId, recipeId])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?
  userId    Int
  recipeId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@unique([userId, recipeId])
}

model Journal {
  id         Int      @id @default(autoincrement())
  userId     Int
  weekStart  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    JournalEntry[]

  @@unique([userId, weekStart])
}

model JournalEntry {
  id          Int      @id @default(autoincrement())
  journalId   Int
  recipeId    Int?
  dayOfWeek   Int
  mealType    MealType

  journal      Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  recipe       Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([journalId, dayOfWeek, mealType])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  recipes     RecipeCategory[]
}

model RecipeCategory {
  recipeId   Int
  categoryId Int

  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([recipeId, categoryId])
}

model Ingredient {
  id        Int    @id @default(autoincrement())
  name      String
  amount    String?
  recipeId  Int
  recipe    Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Step {
  id           Int    @id @default(autoincrement())
  stepNumber   Int
  description  String
  recipeId     Int
  recipe       Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Tutorial {
  id           Int      @id @default(autoincrement())
  recipeId     Int      @unique
  title        String
  description  String
  videoUrl     String
  thumbnailUrl String?
  duration     Int
  price        Int

  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  accesses UserTutorialAccess[]
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  tutorialId Int
  amount    Int
   paymentProof String?

  status    TransactionStatus @default(PENDING)
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tutorial Tutorial @relation(fields: [tutorialId],references: [id],onDelete: Cascade)
  access UserTutorialAccess?
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model UserTutorialAccess {
  id            Int      @id @default(autoincrement())
  userId        Int
  tutorialId    Int
  transactionId Int      @unique
  grantedAt     DateTime @default(now())
  expiresAt     DateTime?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  tutorial Tutorial @relation(fields: [tutorialId],references: [id],onDelete: Cascade)

  transaction Transaction @relation(fields: [transactionId],references: [id])

  @@unique([userId, tutorialId])
}

model Activity {
  id        Int          @id @default(autoincrement())
  userId    Int
  type      ActivityType
  metadata  Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)
}

enum ActivityType {
  RECIPE_SAVED
  REVIEW_POSTED
  TUTORIAL_PURCHASED
}

model RecipeTag {
  id       Int    @id @default(autoincrement())

  name     String

  recipeId Int

  recipe Recipe @relation(fields: [recipeId],references: [id],onDelete: Cascade)

  @@unique([name, recipeId])
}


